---
import Base from '../layouts/Base.astro';
import { assetFor, fetchReleases, formatDate, formatSize } from '../lib/releases';

const releases = await fetchReleases();
const latest = releases[0];

const mac = assetFor(latest, 'macos');
const win = assetFor(latest, 'windows');
const hasBuilds = Boolean(mac || win);
---

<Base
  title="Download Skrab"
  description="Download Skrab for macOS and Windows. Free, open source, and everything stays on your machine."
>
  <section class="head">
    <div class="wrap">
      <span class="eyebrow">Download</span>
      <h1>Get Skrab</h1>
      <p class="lede">
        {
          latest
            ? `Latest release ${latest.tag}${latest.publishedAt ? ` · ${formatDate(latest.publishedAt)}` : ''}`
            : 'Builds are published automatically from GitHub Actions on every tagged release.'
        }
      </p>
    </div>
  </section>

  <section class="wrap">
    {
      !hasBuilds && (
        <div class="card notice">
          <b>No published build yet.</b>
          <p class="muted">
            Skrab is still pre-release. You can build it from source today —{' '}
            <a href="/docs#build">see the build instructions</a>. This page fills in
            automatically the moment the first release is tagged.
          </p>
        </div>
      )
    }

    <div class="platforms">
      <article class="card platform" data-os="macos">
        <span class="platform-bar teal"></span>
        <h2>macOS</h2>
        <p class="muted">Apple silicon &amp; Intel · macOS 11 or newer</p>
        {
          mac ? (
            <>
              <a href={mac.url} class="btn btn-primary full">
                Download .dmg
              </a>
              <p class="dim meta">
                {mac.name} · {formatSize(mac.size)}
              </p>
            </>
          ) : (
            <span class="btn btn-ghost full disabled">Not yet released</span>
          )
        }
        <p class="warn">
          Builds are currently <b>unsigned</b>. macOS will refuse the first launch —
          <a href="/docs#macos-gatekeeper">here is the 20-second fix</a>.
        </p>
      </article>

      <article class="card platform" data-os="windows">
        <span class="platform-bar blue"></span>
        <h2>Windows</h2>
        <p class="muted">Windows 10 &amp; 11 · x64</p>
        {
          win ? (
            <>
              <a href={win.url} class="btn btn-primary full">
                Download installer
              </a>
              <p class="dim meta">
                {win.name} · {formatSize(win.size)}
              </p>
            </>
          ) : (
            <span class="btn btn-ghost full disabled">Not yet released</span>
          )
        }
        <p class="warn">
          SmartScreen may warn on first run until the signing certificate builds
          reputation — <a href="/docs#windows-smartscreen">what to click</a>.
        </p>
      </article>
    </div>

    <div class="card build">
      <h2 id="source">Prefer to build it yourself?</h2>
      <p class="muted">
        Everything is MIT licensed and builds with one command. You need Node 22+,
        pnpm 10+ and a stable Rust toolchain.
      </p>
      <pre class="scroll-x"><code>git clone https://github.com/isttiiak/skrab.git
cd skrab
pnpm install
pnpm --filter @skrab/desktop tauri build</code></pre>
    </div>

    {
      latest && latest.assets.length > 0 && (
        <div class="card all">
          <h2>All files in {latest.tag}</h2>
          <div class="scroll-x">
            <table>
              <thead>
                <tr>
                  <th>File</th>
                  <th>Size</th>
                </tr>
              </thead>
              <tbody>
                {latest.assets.map((asset) => (
                  <tr>
                    <td>
                      <a href={asset.url} class="link">
                        {asset.name}
                      </a>
                    </td>
                    <td class="dim">{formatSize(asset.size)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </section>
</Base>

<script>
  // Highlight whichever platform the visitor is actually on. Progressive
  // enhancement only — both cards are fully usable without this running.
  const platform = navigator.userAgent.includes('Win')
    ? 'windows'
    : navigator.userAgent.includes('Mac')
      ? 'macos'
      : null;

  if (platform) {
    document.querySelector(`[data-os="${platform}"]`)?.classList.add('detected');
  }
</script>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
  }

  .head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-block: 1rem 0.75rem;
  }

  .notice {
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.5rem;
    border-left: 3px solid var(--amber);
  }

  .notice p {
    margin-top: 0.35rem;
    font-size: 0.92rem;
  }

  .notice a,
  .warn a,
  .link {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1.1rem;
  }

  .platform {
    position: relative;
    padding: 1.75rem 1.4rem 1.4rem;
    overflow: hidden;
    transition: border-color 0.18s ease;
  }

  .platform.detected {
    border-color: color-mix(in srgb, var(--teal) 55%, transparent);
    box-shadow: var(--shadow-glow);
  }

  .platform-bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
  }

  .platform-bar.teal {
    background: linear-gradient(90deg, var(--teal), var(--cyan));
  }

  .platform-bar.blue {
    background: linear-gradient(90deg, var(--cyan), var(--blue));
  }

  .platform h2 {
    font-size: 1.25rem;
  }

  .platform p.muted {
    font-size: 0.88rem;
    margin-top: 0.3rem;
  }

  .full {
    width: 100%;
    margin-top: 1.25rem;
  }

  .disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .meta {
    font-size: 0.78rem;
    margin-top: 0.5rem;
    text-align: center;
  }

  .warn {
    font-size: 0.8rem;
    color: var(--ink-muted);
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }

  .build,
  .all {
    padding: 1.5rem 1.4rem;
    margin-top: 1.1rem;
  }

  .build h2,
  .all h2 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  pre {
    margin: 1rem 0 0;
    padding: 0.9rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    font-size: 0.84rem;
    line-height: 1.75;
  }
</style>
