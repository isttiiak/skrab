---
import Base from '../layouts/Base.astro';
import { fetchReleases, formatDate, formatSize } from '../lib/releases';

const releases = await fetchReleases();

/**
 * Minimal Markdown rendering for release bodies.
 *
 * Release notes are generated by our own workflow from Conventional Commits, so the
 * subset is known and small — headings, list items, inline code, bold and links.
 * Everything is HTML-escaped first, so a commit message containing markup cannot
 * inject anything into the page.
 */
function renderNotes(markdown: string): string {
  const escaped = markdown.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  const lines = escaped.split('\n');
  const html: string[] = [];
  let inList = false;

  const closeList = () => {
    if (inList) {
      html.push('</ul>');
      inList = false;
    }
  };

  const inline = (text: string) =>
    text
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(
        /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
        '<a href="$2" rel="noopener noreferrer" target="_blank">$1</a>',
      );

  for (const line of lines) {
    const heading = /^(#{1,4})\s+(.*)$/.exec(line);
    const bullet = /^[-*]\s+(.*)$/.exec(line);

    if (heading) {
      closeList();
      html.push(`<h3>${inline(heading[2] ?? '')}</h3>`);
    } else if (bullet) {
      if (!inList) {
        html.push('<ul>');
        inList = true;
      }
      html.push(`<li>${inline(bullet[1] ?? '')}</li>`);
    } else if (line.trim() === '') {
      closeList();
    } else {
      closeList();
      html.push(`<p>${inline(line)}</p>`);
    }
  }
  closeList();
  return html.join('\n');
}
---

<Base title="Skrab changelog" description="Every Skrab release, what changed, and the files to download.">
  <section class="head">
    <div class="wrap">
      <span class="eyebrow">Changelog</span>
      <h1>What's new</h1>
      <p class="lede">
        Every tagged release, generated from the commit history. Follow the repository
        on GitHub to get notified.
      </p>
    </div>
  </section>

  <section class="wrap">
    {
      releases.length === 0 ? (
        <div class="card empty">
          <b>No releases yet.</b>
          <p class="muted">
            Skrab is pre-release. This page fills in automatically when the first
            version is tagged — until then you can
            <a href="/download#source">build from source</a>.
          </p>
        </div>
      ) : (
        <ol class="timeline">
          {releases.map((release) => (
            <li class="entry">
              <div class="marker">
                <span class="dot" />
              </div>
              <div class="card body">
                <header>
                  <h2>{release.name}</h2>
                  <span class="dim">{formatDate(release.publishedAt)}</span>
                </header>
                <div class="notes" set:html={renderNotes(release.notes)} />
                {release.assets.length > 0 && (
                  <div class="assets">
                    {release.assets.map((asset) => (
                      <a href={asset.url} class="asset">
                        {asset.name}
                        <span class="dim">{formatSize(asset.size)}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
  }

  .head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-block: 1rem 0.75rem;
  }

  .empty {
    padding: 1.25rem 1.4rem;
    border-left: 3px solid var(--amber);
  }

  .empty p {
    margin-top: 0.35rem;
    font-size: 0.92rem;
  }

  .empty a,
  .notes a {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 1rem;
  }

  .marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 1.5rem;
  }

  .marker .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--grad-brand);
    flex: none;
  }

  .marker::after {
    content: "";
    flex: 1;
    width: 2px;
    margin-top: 0.5rem;
    background: linear-gradient(var(--border), transparent);
  }

  .body {
    padding: 1.25rem 1.4rem;
  }

  .body header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .body h2 {
    font-size: 1.2rem;
  }

  .body header span {
    font-size: 0.82rem;
  }

  .notes :global(h3) {
    font-size: 0.98rem;
    margin-block: 1rem 0.4rem;
  }

  .notes :global(ul) {
    margin: 0.35rem 0;
    padding-left: 1.15rem;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .notes :global(li) {
    margin-block: 0.2rem;
  }

  .notes :global(p) {
    color: var(--ink-muted);
    font-size: 0.92rem;
    margin-block: 0.4rem;
  }

  .notes :global(code) {
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .assets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .asset {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.82rem;
    transition: border-color 0.15s ease;
  }

  .asset:hover {
    border-color: var(--teal);
    color: var(--teal);
  }

  .asset span {
    font-size: 0.75rem;
  }
</style>
