{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skrab",
  "version": "0.1.0",
  "identifier": "com.isttiiak.skrab",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Skrab",
        "width": 440,
        "height": 620,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Clipboard manager, screenshot tool, and smart paste workspace.",
    "longDescription": "Skrab replaces the default OS clipboard with a searchable history, a screenshot capture and annotation tool, and a smart paste workspace. Everything stays on your machine.",
    "copyright": "Copyright © 2026 Istiak. MIT licensed.",
    "licenseFile": "../../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {}
}
